# ogg-winmm.HookModule - 32-bit Hookshot hook module, built with MSVC.
# Run build.bat, or nmake /f build.nmake with the toolchain environment active.
# Target is always x86; nmake upcases env names.
# ------------------------------------------------------------------

# Host toolset: the 64-bit host first, the 32-bit host as fallback. The target is
# always x86, so only the \x86\ half of the tool path is resolved.
!IFNDEF HOSTARCH
HOSTARCH =
!IF EXIST("$(VCTOOLSINSTALLDIR)bin\Hostx64\x86\cl.exe")
HOSTARCH = x64
!ELSEIF EXIST("$(VCTOOLSINSTALLDIR)bin\Hostx86\x86\cl.exe")
HOSTARCH = x86
!ENDIF
!ENDIF

CL      = "$(VCTOOLSINSTALLDIR)bin\Host$(HOSTARCH)\x86\cl.exe"
LIBEXE  = "$(VCTOOLSINSTALLDIR)bin\Host$(HOSTARCH)\x86\lib.exe"
LINK    = "$(VCTOOLSINSTALLDIR)bin\Host$(HOSTARCH)\x86\link.exe"

# rc.exe comes from the SDK, whose bin dir carries an x86 or an x64 host subdir
# depending on which pieces of the SDK are installed.
!IF EXIST("$(WINDOWSSDKDIR)Bin\$(WINDOWSSDKVERSION)\x86\rc.exe")
RC = "$(WINDOWSSDKDIR)Bin\$(WINDOWSSDKVERSION)\x86\rc.exe"
!ELSE
RC = "$(WINDOWSSDKDIR)Bin\$(WINDOWSSDKVERSION)\x64\rc.exe"
!ENDIF

# Library roots, named once: the link path and the availability gate both use them.
VCLIB  = $(VCTOOLSINSTALLDIR)lib
SDKLIB = $(WINDOWSSDKDIR)Lib\$(WINDOWSSDKVERSION)

# LIB lists x86 first, so the link names its own library directories.
LIBPATH = /LIBPATH:"$(VCLIB)\x86" \
          /LIBPATH:"$(SDKLIB)\ucrt\x86" \
          /LIBPATH:"$(SDKLIB)\um\x86"

# Hookshot picks this up as ogg-winmm.HookModule.32.dll, beside the game.
DLL = ogg-winmm.HookModule.32.dll

HDRS     = player.h stub.h
OBJS     = obj\ogg-winmm.obj obj\player.obj obj\hookshot_stubs.obj obj\hookshot_entry.obj

RC_IN  = ogg-winmm.rc.in
GEN_RC = obj\ogg-winmm.gen.rc
RES    = obj\ogg-winmm.res

# ---------------------------------------------------------------- deps

# Pinned upstream versions. The tarball URL, the extracted tree name and the cache
# stamp all derive from these, so a version bump is one line plus its hash.
OGG_VER = 1.3.5
OGG_SHA = 0eb4b4b9420a0f51db142ba3f9c64b333f826532dc0f48c6410ae51f4799b664
VOR_VER = 1.3.7
VOR_SHA = 0e982409a9c3fc82ee06e08205b1355e5c6aa4c36bca58146ef399621b0ce5ab

DEPS_DIR = deps
OGG_DIR  = $(DEPS_DIR)\libogg-$(OGG_VER)
VOR_DIR  = $(DEPS_DIR)\libvorbis-$(VOR_VER)
OGG_URL  = https://downloads.xiph.org/releases/ogg/libogg-$(OGG_VER).tar.gz
VOR_URL  = https://downloads.xiph.org/releases/vorbis/libvorbis-$(VOR_VER).tar.gz
DEPOBJ   = obj\dep
DEPLIB   = $(DEPS_DIR)\lib
DEPSTAMP = $(DEPS_DIR)\toolset.stamp

OGG_SRCS  = $(OGG_DIR)\src\bitwise.c $(OGG_DIR)\src\framing.c
OGG_OBJS  = $(DEPOBJ)\libogg\bitwise.obj $(DEPOBJ)\libogg\framing.obj

# Upstream VS2010 list (barkmel/psytune/tone excluded there too).
VOR_SRCS = $(VOR_DIR)\lib\analysis.c $(VOR_DIR)\lib\bitrate.c $(VOR_DIR)\lib\block.c \
           $(VOR_DIR)\lib\codebook.c $(VOR_DIR)\lib\envelope.c $(VOR_DIR)\lib\floor0.c \
           $(VOR_DIR)\lib\floor1.c $(VOR_DIR)\lib\info.c $(VOR_DIR)\lib\lookup.c \
           $(VOR_DIR)\lib\lpc.c $(VOR_DIR)\lib\lsp.c $(VOR_DIR)\lib\mapping0.c \
           $(VOR_DIR)\lib\mdct.c $(VOR_DIR)\lib\psy.c $(VOR_DIR)\lib\registry.c \
           $(VOR_DIR)\lib\res0.c $(VOR_DIR)\lib\sharedbook.c $(VOR_DIR)\lib\smallft.c \
           $(VOR_DIR)\lib\synthesis.c $(VOR_DIR)\lib\vorbisenc.c $(VOR_DIR)\lib\window.c

VOR_OBJS = $(DEPOBJ)\libvorbis\analysis.obj $(DEPOBJ)\libvorbis\bitrate.obj \
           $(DEPOBJ)\libvorbis\block.obj $(DEPOBJ)\libvorbis\codebook.obj \
           $(DEPOBJ)\libvorbis\envelope.obj $(DEPOBJ)\libvorbis\floor0.obj \
           $(DEPOBJ)\libvorbis\floor1.obj $(DEPOBJ)\libvorbis\info.obj \
           $(DEPOBJ)\libvorbis\lookup.obj $(DEPOBJ)\libvorbis\lpc.obj \
           $(DEPOBJ)\libvorbis\lsp.obj $(DEPOBJ)\libvorbis\mapping0.obj \
           $(DEPOBJ)\libvorbis\mdct.obj $(DEPOBJ)\libvorbis\psy.obj \
           $(DEPOBJ)\libvorbis\registry.obj $(DEPOBJ)\libvorbis\res0.obj \
           $(DEPOBJ)\libvorbis\sharedbook.obj $(DEPOBJ)\libvorbis\smallft.obj \
           $(DEPOBJ)\libvorbis\synthesis.obj $(DEPOBJ)\libvorbis\vorbisenc.obj \
           $(DEPOBJ)\libvorbis\window.obj

FILE_SRCS = $(VOR_DIR)\lib\vorbisfile.c
FILE_OBJS = $(DEPOBJ)\libvorbisfile\vorbisfile.obj

DEPS_LIBS = $(DEPLIB)\libogg.lib $(DEPLIB)\libvorbis.lib $(DEPLIB)\libvorbisfile.lib

DEP_CFLAGS = /nologo /c /W3 /O2 /MD /DNDEBUG /DWIN32 \
             /D_CRT_SECURE_NO_WARNINGS /D_CRT_NONSTDC_NO_WARNINGS \
             /I"$(OGG_DIR)\include" /I"$(VOR_DIR)\include" /I"$(VOR_DIR)\lib"

# ---------------------------------------------------------------- module

# CRT/SDK headers come from INCLUDE; only project includes are named here.
MOD_INCS = /IHookshot\Include\Hookshot /I"$(OGG_DIR)\include" /I"$(VOR_DIR)\include"

CFLAGS = /nologo /c /W3 /O2 /MD /DNDEBUG /DWIN32 \
         /D_CRT_SECURE_NO_WARNINGS /D_CRT_NONSTDC_NO_WARNINGS $(MOD_INCS)

# /std:c++20 for the concepts in HookshotInterface.h.
CXXFLAGS = /nologo /c /TP /W3 /O2 /MD /DNDEBUG /EHsc /std:c++20 $(MOD_INCS)

LIBS = winmm.lib user32.lib gdi32.lib advapi32.lib ole32.lib shell32.lib \
       "$(DEPLIB)\libvorbisfile.lib" "$(DEPLIB)\libvorbis.lib" "$(DEPLIB)\libogg.lib"

# ---------------------------------------------------------------- targets

# The target needs a compiler that can emit x86 code plus the libraries from both
# the toolset and the SDK.
X86_LIBS =
!IF EXIST("$(VCLIB)\x86") && EXIST("$(SDKLIB)\ucrt\x86") && EXIST("$(SDKLIB)\um\x86")
X86_LIBS = 1
!ENDIF

all: $(DLL)

# The vendored libraries are cached against the toolset that built them. That check
# runs here: after the environment checks, and before nmake decides what is out of
# date - so a changed toolset drops the cached libraries and they rebuild in this
# same run. It is deliberately not a prerequisite of them: a target that is remade
# on every build makes its dependents out of date on every build.
toolchain:
	@if "$(VCTOOLSINSTALLDIR)"=="" (echo Error: no toolchain environment - run build.bat, or activate one first & exit 1)
	@if "$(HOSTARCH)"=="" (echo Error: no x86-targeting host toolset under "$(VCTOOLSINSTALLDIR)bin" - expected Hostx64\x86 or Hostx86\x86 & exit 1)
	@if "$(X86_LIBS)"=="" (echo Error: no 32-bit libraries - the toolset lib\x86 or the SDK ucrt\x86 and um\x86 are missing & exit 1)
	@if not exist $(RC) (echo Error: no rc.exe under "$(WINDOWSSDKDIR)Bin\$(WINDOWSSDKVERSION)" - run build.bat, or activate one first & exit 1)
	@call build.bat --stamp "$(VCTOOLSINSTALLDIR)" "$(HOSTARCH)" "$(WINDOWSSDKVERSION)"

# The vendored sources have to be on disk before anything compiles them; fetch gets them.
depsources:
	@if not exist "$(OGG_DIR)\src\framing.c" (echo Error: the ogg/vorbis sources are missing from $(DEPS_DIR)\ & echo        Run: build.bat fetch & exit 1)
	@if not exist "$(VOR_DIR)\lib\vorbisfile.c" (echo Error: the ogg/vorbis sources are missing from $(DEPS_DIR)\ & echo        Run: build.bat fetch & exit 1)

fetch:
	@if not exist $(DEPS_DIR) mkdir $(DEPS_DIR)
	@call build.bat --fetchdep libogg $(OGG_VER) $(OGG_SHA) $(OGG_URL)
	@call build.bat --fetchdep libvorbis $(VOR_VER) $(VOR_SHA) $(VOR_URL)
	@echo $(DEPS_DIR)\ ready.

obj:
	@if not exist obj mkdir obj

$(DEPLIB)\libogg.lib: $(OGG_SRCS)
	@if not exist $(DEPOBJ)\libogg mkdir $(DEPOBJ)\libogg
	@if not exist $(DEPLIB) mkdir $(DEPLIB)
	@$(CL) $(DEP_CFLAGS) /Fo$(DEPOBJ)\libogg\ $(OGG_SRCS)
	@$(LIBEXE) /nologo /OUT:$@ $(OGG_OBJS)

$(DEPLIB)\libvorbis.lib: $(VOR_SRCS)
	@if not exist $(DEPOBJ)\libvorbis mkdir $(DEPOBJ)\libvorbis
	@if not exist $(DEPLIB) mkdir $(DEPLIB)
	@$(CL) $(DEP_CFLAGS) /Fo$(DEPOBJ)\libvorbis\ $(VOR_SRCS)
	@$(LIBEXE) /nologo /OUT:$@ $(VOR_OBJS)

$(DEPLIB)\libvorbisfile.lib: $(FILE_SRCS)
	@if not exist $(DEPOBJ)\libvorbisfile mkdir $(DEPOBJ)\libvorbisfile
	@if not exist $(DEPLIB) mkdir $(DEPLIB)
	@$(CL) $(DEP_CFLAGS) /Fo$(DEPOBJ)\libvorbisfile\ $(FILE_SRCS)
	@$(LIBEXE) /nologo /OUT:$@ $(FILE_OBJS)

$(GEN_RC): $(RC_IN) resource\version.txt
	@call build.bat --genrc

$(RES): $(GEN_RC) obj
	$(RC) /nologo /fo$(RES) $(GEN_RC)

obj\ogg-winmm.obj: ogg-winmm.c $(HDRS) obj
	$(CL) $(CFLAGS) /Fo$@ ogg-winmm.c

obj\player.obj: player.c $(HDRS) obj
	$(CL) $(CFLAGS) /Fo$@ player.c

obj\hookshot_stubs.obj: hookshot_stubs.c $(HDRS) obj
	$(CL) $(CFLAGS) /Fo$@ hookshot_stubs.c

obj\hookshot_entry.obj: hookshot_entry.cpp $(HDRS) obj
	$(CL) $(CXXFLAGS) /Fo$@ hookshot_entry.cpp

$(DLL): toolchain depsources $(OBJS) $(RES) $(DEPS_LIBS)
	$(CL) /nologo /Fe$(DLL) $(OBJS) $(RES) /link /DLL /MACHINE:X86 \
	    /IMPLIB:obj\ogg-winmm.HookModule.32.lib $(LIBS) $(LIBPATH)
	@$(LINK) /dump /exports $(DLL) | findstr /C:"HookshotMain" >NUL || (echo Error: HookshotMain is not exported from $(DLL) & exit 1)
	@$(LINK) /dump /headers $(DLL) | findstr /C:"14C machine" >NUL || (echo Error: $(DLL) is not a 32-bit binary & exit 1)
	@(where upx >NUL 2>&1 && upx --best $(DLL)) || echo   upx not found or failed - leaving the DLL unpacked

clean:
	@if not exist obj if not exist $(DLL) echo   nothing to remove
	@if exist obj (rmdir /s /q obj & echo   removed obj\)
	@if exist $(DLL) (del /q $(DLL) & echo   removed $(DLL))

# The built dependency libraries only - the fetched sources are left alone.
cleandep:
	@if not exist $(DEPLIB)\libogg.lib if not exist $(DEPLIB)\libvorbis.lib if not exist $(DEPLIB)\libvorbisfile.lib if not exist $(DEPSTAMP) echo   nothing to remove
	@if exist $(DEPLIB)\libogg.lib (del /q $(DEPLIB)\libogg.lib & echo   removed $(DEPLIB)\libogg.lib)
	@if exist $(DEPLIB)\libvorbis.lib (del /q $(DEPLIB)\libvorbis.lib & echo   removed $(DEPLIB)\libvorbis.lib)
	@if exist $(DEPLIB)\libvorbisfile.lib (del /q $(DEPLIB)\libvorbisfile.lib & echo   removed $(DEPLIB)\libvorbisfile.lib)
	@if exist $(DEPSTAMP) (del /q $(DEPSTAMP) & echo   removed $(DEPSTAMP))
